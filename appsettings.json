{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "AplicationName": "Chimin&Ungi",
    "MaxProductsPerPage": 20,
    "EnableProductLogging": true
  },

  "AdminUsers": [
    {
      "Username": "user1",
      "Password": "123",
      "Role": "User"
    },
    {
      "Username": "admin1",
      "Password": "123",
      "Role": "Admin"
    },
    {
      "Username": "superadmin",
      "Password": "123",
      "Role": "SuperAdmin"
    }
  ],
  {
    "AppSettings": {
      "ApplicationName": "Product API",
      "MaxProductsPerPage": 10,
      "ProductsPerPage": 5
    },

    "Pagination": {
      "PageNumber": 1,
      "ProductsPerPage": 5
    },

    "Serialog": {
      "MinimumLevel": "Information",
      "WriteTo": {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "rollingInterval": "Day"
        }
      }
    },
    {
      "RateLimiting": {
        "PermitLimit": 100000,
        "WindowMinutes": 1,
        "QueueLimit":  0
      }
    }
  }
  /*
  види логів (спеціальний текстовий файл з журналом подій, помилок і видаленних файлів, про роботу системи у хронологічному порядку)
  Trace - максимально детальна інформація (наприклад по яким папкам шукає знайшло чи нє)
  Debug - інформація для розробки
  Information - будь-яка інформація  (наприклад інформація, що почався пошук по папкам)
  Warning - попередження 
  Error - помилки
  Critical - критичні помилки
  */
}
